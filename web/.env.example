# Web app connections. Copy to web/.env (setup.sh generates it for you).

# Postgres — must match the host port published by docker-compose (root .env PG_PUBLISH_PORT).
PG_HOST=localhost
PG_PORT=5432
PG_USER=rag
PG_PASSWORD=rag
PG_DATABASE=rag

# LightRAG
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_API_KEY=neville-local-key

# Coach LLM (generation). This is the voice the user reads — pick the best your box runs.
# Separate from the extraction model in lightrag.env.
OLLAMA_URL=http://localhost:11434
GEN_MODEL=__COACH_MODEL__

# Guard against a wedged local model pinning a request (and its pg pool slot)
# forever. For the stream this is an *inactivity* timeout, so a slow-but-
# progressing generation is never killed. 0/unset means "use the default",
# never "no timeout" — cf. LLM_TIMEOUT=0 killing the LightRAG worker.
GEN_TIMEOUT_MS=300000

# --- Journal semantic search ---
# Embeds your own log entries so the coach can find past moments by meaning
# rather than by substring. Its own model: a chat model is not an embedder, and
# lightrag.env's EMBEDDING_MODEL belongs to the container, not this app.
# Journal vectors live in their own table and are never compared against corpus
# vectors, so changing this is a cheap self-healing backfill, not a re-index.
EMBED_MODEL=__EMBED_MODEL__
EMBED_TIMEOUT_MS=30000

# --- Retrieval ---
# The corpus is static, so retrieved context caches well. The cache key includes
# the embedding model + dim, so a re-index invalidates it rather than poisoning it.
RETRIEVAL_CACHE=1
RETRIEVAL_CACHE_TTL_SEC=86400
# Local graph retrieval is slow; this bounds it.
LIGHTRAG_QUERY_TIMEOUT_MS=120000
# Prefer LightRAG's structured /query/data endpoint, which returns per-chunk
# file_path metadata — that is where source citations come from. Set to 0 to
# force the legacy /query + only_need_context path.
LIGHTRAG_STRUCTURED_QUERY=1

# --- Auth ---
# Set to 1 only when a reverse proxy you control sits in front of the app. The
# rightmost X-Forwarded-For hop is then treated as the client address for login
# rate limiting. Left at 0, forwarded headers are recorded but tagged unverified.
TRUST_PROXY=0

# Add `Secure` to the session cookie. Keep 0 for plain-HTTP localhost dev: the
# browser drops a Secure cookie over http:// and sign-in silently fails.
COOKIE_SECURE=0

# Browser origins allowed to read the JSON API (comma-separated, exact match,
# e.g. https://app.example.com). Empty = allow loopback and private-LAN origins
# only, which is what the Expo dev web target uses. Never set to `*` — cookies
# are not exposed cross-origin and should stay that way.
CORS_ALLOWED_ORIGINS=
