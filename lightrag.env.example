# LightRAG server config. Mounted into the lightrag container.
# Copy to lightrag.env (setup.sh generates it and fills the model lines for you).
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE=Neville Knowledge Graph
WEBUI_DESCRIPTION=Neville Goddard teaching — graph + vector RAG

# --- Auth: shared key the frontend sends as X-API-Key (local-only default) ---
LIGHTRAG_API_KEY=neville-local-key

# --- Storage: everything in Postgres (pgvector + Apache AGE) ---
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DATABASE=neville
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_VECTOR_INDEX_TYPE=HNSW

# --- LLM: entity extraction / indexing ONLY (the coach calls its own model directly) ---
# Use a SMALL fast model here — extraction runs once per chunk and a big model
# takes minutes/chunk on a local box. KG quality stays good; coach voice is set
# separately in web/.env (COACH/GEN model).
LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_MODEL=__EXTRACT_MODEL__
LLM_BINDING_API_KEY=ollama
MAX_TOTAL_TOKENS=30000
# Generous FINITE timeouts. Do NOT set 0 — the worker queue reads it as 0s and fails instantly.
LLM_TIMEOUT=1800
TIMEOUT=1800
EMBEDDING_TIMEOUT=300

# --- Embeddings (host Ollama). DIM is auto-detected by setup.sh. ---
# Embedding model + dim are FIXED once you ingest. Changing them needs a re-index.
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=__EMBED_MODEL__
EMBEDDING_DIM=__EMBED_DIM__
EMBEDDING_BINDING_API_KEY=ollama

# --- Indexing throughput on local hardware ---
# Bigger chunks => fewer slow extraction calls. 1500 is the recommended max.
CHUNK_SIZE=1500
CHUNK_OVERLAP_SIZE=100
MAX_ASYNC=2
EMBEDDING_FUNC_MAX_ASYNC=2
SUMMARY_LANGUAGE=English
ENABLE_LLM_CACHE=true
