# OS
.DS_Store

# Generated env (created by setup.sh from the .example templates)
.env
lightrag.env
web/.env

# Postgres data + LightRAG storage volumes (rebuilt by `docker compose up` + ingest)
/data/

# Corpus source PDFs are large; ship the extracted .txt instead.
# Re-derive PDFs/txt per corpus/README.md if you want them.
corpus/*.pdf

# Lecture transcripts: scraped for personal local use, source sites reserve
# copyright and don't grant redistribution — keep local only, never commit.
corpus/lectures/

# Node
node_modules/
web/node_modules/
mobile/node_modules/

# React Router build artifacts
web/.react-router/
web/build/

# Expo mobile app
mobile/.expo/
mobile/dist/
mobile/.env
mobile/web-build/
mobile/ios/
mobile/android/
*.hbc

# Agent scratch
.claude/scheduled_tasks.lock
